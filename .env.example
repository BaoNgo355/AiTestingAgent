# Khóa API cho Google Antigravity SDK (Gemini Developer API - lấy key tại https://aistudio.google.com/app/api-keys)
GEMINI_API_KEY=your_gemini_api_key_here

# Tùy chọn: ghi đè model của SDK (để trống/null để SDK tự dùng mặc định gemini-3.8-flash)
# AITEST_MODEL=gemini-3.8-flash

# Tùy chọn: bật Gemini Enterprise Agent Platform (Vertex AI)
# AITEST_LLM__VERTEX=false
# GOOGLE_CLOUD_PROJECT=your-gcp-project
# GOOGLE_CLOUD_LOCATION=us-central1
